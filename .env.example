# Oracle Autonomous Database 접속 정보
ORACLE_DSN=<host>:<port>/<service_name>
ORACLE_USER=<username>
ORACLE_PASSWORD=<password>

# 또는 Wallet 사용 시
# ORACLE_WALLET_DIR=/path/to/wallet
# ORACLE_WALLET_PASSWORD=<wallet_password>

# Select AI 프로필명 (미지정 시 DB에서 동적으로 조회)
# SELECT_AI_PROFILE=GROQ_PROFILE

# 앱 설정
APP_HOST=0.0.0.0
APP_PORT=8000

# 벡터 임베딩 설정
# DB 내 ONNX 모델을 사용하는 경우:
EMBEDDING_MODEL=minilm_l12_v2
EMBEDDING_SOURCE=database

# 외부 임베딩 API를 사용하는 경우:
# EMBEDDING_SOURCE=external
# EMBEDDING_API_URL=https://api.groq.com/openai/v1/embeddings
# EMBEDDING_API_KEY=<api_key>
# EMBEDDING_MODEL=text-embedding-ada-002

# ── LLM 채팅 설정 (AWR 분석, RAG 답변 생성용) ──
# Groq (무료, OpenAI 호환 API)
GROQ_API_KEY=<groq_api_key>
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (무료, OpenAI 호환 API)
GOOGLE_API_KEY=<google_api_key>
GOOGLE_MODEL=gemini-2.5-flash

# 기본 LLM 제공자 (groq 또는 google)
LLM_PROVIDER=google
