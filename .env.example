# Oracle Autonomous Database 접속 정보
ORACLE_DSN=<host>:<port>/<service_name>
ORACLE_USER=<username>
ORACLE_PASSWORD=<password>

# 또는 Wallet 사용 시
# ORACLE_WALLET_DIR=/path/to/wallet
# ORACLE_WALLET_PASSWORD=<wallet_password>

# Select AI 프로필명 (미지정 시 DB에서 동적으로 조회)
# SELECT_AI_PROFILE=GROQ_PROFILE

# 앱 설정
APP_HOST=0.0.0.0
APP_PORT=8000

# ── 벡터 임베딩 설정 ──
# DB 내장(ONNX): EMBEDDING_SOURCE=database, EMBEDDING_MODEL=DB에 로드된 ONNX 모델명
# 외부 API:     EMBEDDING_SOURCE=external, 아래 API 설정 필요
EMBEDDING_SOURCE=database
EMBEDDING_MODEL=MULTI_MINILM_L12_V2
EMBEDDING_DIM=768
# EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/embeddings
# EMBEDDING_API_KEY=<api_key>

# ── LLM 설정 (AWR 분석, RAG 답변 생성용 — UI에서 변경 가능) ──
# 기본 LLM 제공자 (앱 시작 시 기본 선택값)
LLM_PROVIDER=google

# Google Gemini
GOOGLE_API_KEY=<google_api_key>
GOOGLE_MODEL=gemini-2.5-flash

# Groq (Llama 3.3 70B)
GROQ_API_KEY=<groq_api_key>
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI
# OPENAI_API_KEY=<openai_api_key>
# OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
# ANTHROPIC_API_KEY=<anthropic_api_key>
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# xAI (Grok)
# XAI_API_KEY=<xai_api_key>
# XAI_MODEL=grok-3
